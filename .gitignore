.DS_Store

# Generated by test/build.py from index.html — never edit or commit these.
test/build/

# Generated by tools/make-zip.sh after every commit and pull. It is a snapshot of
# what is already in this repo, so committing it would bloat the history with a new
# binary copy of everything on every single commit.
*.zip

# A separate project that lives alongside this one, with its own git repo and its own
# GitHub Pages site. Ignored so this repo does not try to swallow it.
tic-tac-toe/
